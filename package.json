{
  "name": "@rsaglobaltech/forja",
  "version": "1.0.6",
  "description": "Scaffold hexagonal projects: web + mobile monorepos in TypeScript, or a Java API (Spring Boot / Quarkus) with a web app, OAuth2, ArchUnit and Specgate.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsaglobaltech/forja.git"
  },
  "homepage": "https://rsaglobaltech.github.io/forja/",
  "bugs": {
    "url": "https://github.com/rsaglobaltech/forja/issues"
  },
  "keywords": [
    "scaffolding",
    "cli",
    "hexagonal",
    "ddd",
    "monorepo",
    "nextjs",
    "expo",
    "spring-boot",
    "quarkus",
    "oauth2",
    "specgate"
  ],
  "bin": {
    "forja": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "site": "tsx scripts/site/build.ts --out _site",
    "site:publish": "tsx scripts/site/build.ts --out docs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "ejs": "^3.1.10",
    "execa": "^9.5.2",
    "memfs": "^4.17.0",
    "prettier": "^3.4.2",
    "ts-morph": "^25.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.10.5",
    "eslint": "^9.39.5",
    "marked": "^18.0.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.0.4"
  }
}
