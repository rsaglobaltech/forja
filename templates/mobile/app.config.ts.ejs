import type { ExpoConfig } from "expo/config";
<% const appId = "com." + config.scope.replace(/[^a-z0-9]/g, "") + "." + config.name.replace(/[^a-z0-9]/g, ""); %>

const config: ExpoConfig = {
  name: "<%= config.name %>",
  slug: "<%= config.name %>",
  scheme: "<%= config.name.replace(/-/g, "") %>",
  version: "1.0.0",
  orientation: "portrait",
  userInterfaceStyle: "automatic",
  ios: {
    supportsTablet: true,
    bundleIdentifier: "<%= appId %>",
  },
  android: {
    // Android package names allow only letters, digits and underscores.
    package: "<%= appId %>",
  },
  web: {
    bundler: "metro",
    output: "single",
  },
  plugins: ["expo-router", "expo-secure-store"],
  experiments: {
    typedRoutes: true,
  },
  extra: {
    apiUrl: process.env.EXPO_PUBLIC_API_URL ?? null,
  },
};

export default config;
