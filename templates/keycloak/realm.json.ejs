{
  "realm": "<%= config.name %>",
  "enabled": true,
  "displayName": "<%= config.name %> (development)",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "web",
      "name": "<%= config.name %> web",
      "description": "Next.js (Auth.js): Authorization Code + PKCE. Development-only secret.",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    },
    {
      "clientId": "dev-cli",
      "name": "Manual and E2E testing",
      "description": "Development only: lets you request a token with username and password (curl, tests).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "<%= config.name %>",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }]
    },
    {
      "username": "other",
      "email": "other@example.com",
      "emailVerified": true,
      "firstName": "Other",
      "lastName": "Person",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "other", "temporary": false }]
    }
  ]
}
