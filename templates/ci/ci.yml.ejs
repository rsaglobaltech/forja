# CI for <%= config.name %> (generated with forja). Runs on every push and pull request.
name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
<% if (java) { -%>
  api:
    name: API (<%= backendName %>)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: apps/api
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"
          cache: maven
      # Domain, use case and API tests<%= config.db === "postgres-docker" ? " against a real PostgreSQL (Docker)" : "" %>, real startup<%= config.archunit ? " and ArchUnit" : "" %>.
      - run: ./mvnw -B verify
<% } -%>
<% if (web || !java) { -%>
  <%= java ? "web" : "app" %>:
    name: <%= java ? "Web (Next.js)" : "App" %>
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - name: Dependencies
        run: if [ -f package-lock.json ]; then npm ci; else npm install; fi
<% if (config.extras.includes("lint")) { -%>
      - run: npm run lint
<% } -%>
<% if (java) { -%>
      - run: npm run test:web
<% } else { -%>
      - run: npm run typecheck
      - run: npm test
<% } -%>
<% } -%>
<% if (config.extras.includes("specgate")) { -%>
  spec:
    name: Specification (Specgate)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      # The specification: requirements, scenarios and traceability. The tests already run in the other jobs.
      - run: npx -y @rsaglobaltech/specgate@<%= versions.specgate %> validate . --strict
<% } -%>
