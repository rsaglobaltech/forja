import type { NextConfig } from "next";
import path from "node:path";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));

const nextConfig: NextConfig = {
  transpilePackages: ["<%= config.scope %>/shared", "<%= config.scope %>/core"],
  // Evita que Next "adivine" mal la raíz del monorepo al tracear archivos
  // para el build (típico en setups con más de un lockfile en el árbol).
  outputFileTracingRoot: path.join(__dirname, "../.."),
  webpack(config) {
    // packages/core y packages/shared importan entre módulos con extensión
    // .js (ESM en Node/tsx/vitest lo exige), pero los archivos son .ts.
    // Sin este alias, el resolver de webpack no encuentra esos módulos al
    // transpilar los workspaces.
    config.resolve.extensionAlias = {
      ".js": [".ts", ".tsx", ".js"],
    };
    return config;
  },
};

export default nextConfig;
