import type { NextConfig } from "next";
import path from "node:path";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));

const nextConfig: NextConfig = {
  transpilePackages: ["<%= config.scope %>/shared", "<%= config.scope %>/core"],
  // Stops Next from guessing the wrong monorepo root when tracing files
  // for the build (common in setups with more than one lockfile in the tree).
  outputFileTracingRoot: path.join(__dirname, "../.."),
  webpack(config) {
    // packages/core and packages/shared import each other's modules with a
    // .js extension (ESM in Node/tsx/vitest requires it), but the files are .ts.
    // Without this alias, webpack's resolver cannot find those modules when
    // transpiling the workspaces.
    config.resolve.extensionAlias = {
      ".js": [".ts", ".tsx", ".js"],
    };
    return config;
  },
};

export default nextConfig;
