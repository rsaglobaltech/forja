quarkus.application.name=<%= config.name %>-api
quarkus.http.port=${PORT:8080}

# CORS: the development frontend (separate multiple origins with commas).
quarkus.http.cors.enabled=true
quarkus.http.cors.origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000}
quarkus.http.cors.methods=GET,POST,PUT,PATCH,DELETE
quarkus.http.cors.headers=Authorization,Content-Type

# OpenAPI at /q/openapi and Swagger UI at /q/swagger-ui (in production too: remove if unwanted).
quarkus.swagger-ui.always-include=true
<% if (config.db === "postgres-docker") { -%>

quarkus.datasource.db-kind=postgresql
quarkus.flyway.migrate-at-start=true
# In development and tests, Quarkus starts PostgreSQL by itself (Dev Services, with Docker).
# In production, through environment variables.
%prod.quarkus.datasource.jdbc.url=${DB_URL:jdbc:postgresql://localhost:${DB_PORT:5432}/<%= dbName %>}
%prod.quarkus.datasource.username=${DB_USER:postgres}
%prod.quarkus.datasource.password=${DB_PASSWORD:postgres}
<% } -%>
<% if (config.auth === "oauth2") { -%>

# OAuth2/OIDC: the API validates the JWT (the docker-compose Keycloak in development; OIDC_ISSUER in production).
quarkus.oidc.application-type=service
quarkus.oidc.auth-server-url=${OIDC_ISSUER:http://localhost:8180/realms/<%= config.name %>}
quarkus.oidc.token.principal-claim=sub
# No automatic Quarkus Keycloak: development uses the docker-compose one (with the infra/keycloak realm).
quarkus.keycloak.devservices.enabled=false
# Authentication is resolved in the resources (@Authenticated) so errors come out as RFC 9457.
quarkus.http.auth.proactive=false
# Tests mock the identity (@TestSecurity) without contacting the provider.
%test.quarkus.oidc.tenant-enabled=false
<% } -%>
