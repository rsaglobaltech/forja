package <%= pkg %>.shared.infrastructure.security;

import <%= pkg %>.shared.application.CurrentUser;
import io.quarkus.security.identity.SecurityIdentity;
import jakarta.enterprise.context.RequestScoped;

/** The current user is the JWT {@code sub} (quarkus.oidc.token.principal-claim=sub). */
@RequestScoped
class JwtCurrentUser implements CurrentUser {
  private final SecurityIdentity identity;

  JwtCurrentUser(SecurityIdentity identity) { this.identity = identity; }

  @Override
  public String id() {
    if (identity.isAnonymous()) throw new IllegalStateException("No authenticated user: the route should require a token");
    return identity.getPrincipal().getName();
  }
}
