spring:
  application:
    name: <%= config.name %>-api
<% if (config.db === "postgres-docker") { -%>
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:${DB_PORT:5432}/<%= dbName %>}
    username: ${DB_USER:postgres}
    password: ${DB_PASSWORD:postgres}
<% } -%>
<% if (config.auth === "oauth2") { -%>
  security:
    oauth2:
      resourceserver:
        jwt:
          # The docker-compose Keycloak (infra/keycloak/<%= config.name %>-realm.json). In production, the real issuer.
          issuer-uri: ${OIDC_ISSUER:http://localhost:8180/realms/<%= config.name %>}
<% } -%>

server:
  port: ${PORT:8080}

app:
  cors:
    # The development frontend. Separate multiple origins with commas.
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:3000}

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      probes:
        enabled: true

springdoc:
  swagger-ui:
    path: /swagger-ui.html
