package <%= pkg %>.shared.infrastructure.security;

import <%= pkg %>.shared.application.CurrentUser;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.stereotype.Component;

/** The current user is the JWT {@code sub}: stable even if their name or email changes. */
@Component
class JwtCurrentUser implements CurrentUser {
  @Override
  public String id() {
    Authentication auth = SecurityContextHolder.getContext().getAuthentication();
    if (auth != null && auth.getPrincipal() instanceof Jwt jwt) return jwt.getSubject();
    throw new IllegalStateException("No authenticated user: the route should require a token");
  }
}
