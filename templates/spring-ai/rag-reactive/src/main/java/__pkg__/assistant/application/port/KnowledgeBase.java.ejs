/** Outbound port: where notes are kept, searchable by meaning. The adapter is a Spring AI vector store. */
public interface KnowledgeBase {
  Mono<Void> add(String owner, Note note);

  /** The owner's passages closest to the question; empty when none is close enough. */
  Flux<Passage> search(String owner, Question question);
}
