<% if (ai) { -%>
  ai:
<% if (ai.store !== "none") { -%>
    # The size of the <%= ai.embeddings %> embeddings: known in advance so startup never calls the provider.
    embedding-dimensions: <%= ai.dimensions %>
<% } -%>
<% if (ai.store === "pgvector" && config.reactive) { -%>
    # PGVector is JDBC-only: its own small pool (the API itself uses R2DBC).
    vectors:
      datasource:
        jdbc-url: ${DB_URL:jdbc:postgresql://localhost:${DB_PORT:5432}/<%= dbName %>}
        username: ${DB_USER:postgres}
        password: ${DB_PASSWORD:postgres}
        maximum-pool-size: 4
<% } -%>
<% if (ai.store !== "none") { -%>
  assistant:
    # Passages per answer, and the cosine similarity a note needs to count. Tune it for your embeddings.
    top-k: 4
    min-similarity: 0.4
<% } -%>
<% } -%>
