# Copy to apps/api/.env (git-ignored) and fill in: Spring Boot reads it on startup (spring.config.import).
# In production, set the same variables in the environment instead.
<% if (ai.chat === "anthropic") { -%>
ANTHROPIC_API_KEY=
<% } -%>
<% if (ai.chat === "openai" || ai.embeddings === "openai") { -%>
OPENAI_API_KEY=
<% } -%>
<% if (ai.chat === "google-genai" || ai.embeddings === "google-genai") { -%>
GEMINI_API_KEY=
<% } -%>
<% if (ai.ollama) { -%>
# Ollama runs in docker compose; another one?
# OLLAMA_BASE_URL=http://localhost:11434
<% } -%>
<% if (ai.chat === "ollama") { -%>
# OLLAMA_CHAT_MODEL=llama3.2
<% } -%>
