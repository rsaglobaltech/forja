package <%= pkg %>.assistant.application;

import <%= pkg %>.assistant.application.port.LanguageModel;
<% if (ai.store !== "none") { -%>
import <%= pkg %>.assistant.application.port.KnowledgeBase;
import <%= pkg %>.assistant.domain.Answer;
import <%= pkg %>.assistant.domain.Passage;
<% } -%>
import <%= pkg %>.assistant.domain.Question;
<% if (ai.store !== "none") { -%>
import <%= pkg %>.shared.application.CurrentUser;
<% } -%>
import java.util.List;
<% if (ai.store !== "none") { -%>
import reactor.core.publisher.Flux;
<% } -%>
import reactor.core.publisher.Mono;

<% if (ai.store !== "none") { -%>
/**
 * Use case: answer a question from the current user's notes (retrieval-augmented generation). The retrieval
 * is here, not hidden in the AI library: when nothing in the notes is close enough, the model is not asked at
 * all — no cost, and no answer made up from nothing.
 */
<% } else { -%>
/** Use case: answer a question with the language model, streamed. Instantiated in infrastructure/config. */
<% } -%>
public final class AskAssistant {
  private final LanguageModel model;
<% if (ai.store !== "none") { -%>
  private final KnowledgeBase notes;
  private final CurrentUser user;

  public AskAssistant(LanguageModel model, KnowledgeBase notes, CurrentUser user) {
    this.model = model;
    this.notes = notes;
    this.user = user;
  }

  public Mono<Reply> execute(String text) {
    return Mono.fromCallable(() -> new Question(text)).zipWith(user.id())
        .flatMap(t -> notes.search(t.getT2(), t.getT1()).collectList().map(context -> reply(t.getT1(), context)));
  }

  private Reply reply(Question question, List<Passage> context) {
    if (context.isEmpty()) return new Reply(List.of(), Flux.just(Answer.NOTHING_FOUND));
    return new Reply(context.stream().map(Passage::title).distinct().toList(), model.answer(question, context));
  }
<% } else { -%>

  public AskAssistant(LanguageModel model) {
    this.model = model;
  }

  public Mono<Reply> execute(String text) {
    return Mono.fromCallable(() -> new Question(text)).map(q -> new Reply(List.of(), model.answer(q)));
  }
<% } -%>
}
