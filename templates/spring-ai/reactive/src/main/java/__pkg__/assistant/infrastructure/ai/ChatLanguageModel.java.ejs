package <%= pkg %>.assistant.infrastructure.ai;

import <%= pkg %>.assistant.application.port.LanguageModel;
import <%= pkg %>.assistant.domain.Question;
<% if (ai.store !== "none") { -%>
import <%= pkg %>.assistant.domain.Passage;
import java.util.List;
<% } -%>
import org.springframework.ai.chat.client.ChatClient;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Flux;

/**
 * Adapter: the language model through Spring AI's ChatClient, streamed — the provider's tokens reach the
 * client as they are written, and no thread waits for the whole answer.
 */
@Component
class ChatLanguageModel implements LanguageModel {
  private final ChatClient chat;

  ChatLanguageModel(ChatClient.Builder chat) {
    this.chat = chat.defaultSystem(Prompts.SYSTEM).build();
  }

  @Override
<% if (ai.store !== "none") { -%>
  public Flux<String> answer(Question question, List<Passage> context) {
    return chat.prompt().user(Prompts.user(question, context)).stream().content();
  }
<% } else { -%>
  public Flux<String> answer(Question question) {
    return chat.prompt().user(Prompts.user(question)).stream().content();
  }
<% } -%>
}
