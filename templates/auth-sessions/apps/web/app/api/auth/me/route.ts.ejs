import { NextResponse, type NextRequest } from "next/server";
import { container } from "<%= config.scope %>/core";
import { resolveUserId } from "../../_lib/session.js";
import { corsHeaders } from "../../_lib/cors.js";

export async function OPTIONS() {
  return new NextResponse(null, { status: 204, headers: corsHeaders() });
}

export async function GET(request: NextRequest) {
  const userId = await resolveUserId(request);
  if (!userId) {
    return NextResponse.json(
      { error: "unauthorized", message: "Not authenticated" },
      { status: 401, headers: corsHeaders() },
    );
  }

  const user = await container.userRepository.findById(userId);
  if (!user) {
    return NextResponse.json(
      { error: "unauthorized", message: "Not authenticated" },
      { status: 401, headers: corsHeaders() },
    );
  }

  return NextResponse.json({ userId: user.id, email: user.email.toString() }, { headers: corsHeaders() });
}
