<% if (config.auth === "sessions") { -%>
import { env, hasDatabase } from "./env.js";
import { SystemClock } from "../clock/SystemClock.js";
import { ConsoleLogger } from "../logging/ConsoleLogger.js";
import { BcryptPasswordHasher } from "../security/BcryptPasswordHasher.js";
import { InMemoryUserRepository } from "../database/repositories/InMemoryUserRepository.js";
import { InMemorySessionRepository } from "../database/repositories/InMemorySessionRepository.js";
import { InMemoryPasswordResetTokenRepository } from "../database/repositories/InMemoryPasswordResetTokenRepository.js";
<% if (config.db === "postgres-docker") { -%>
import { DrizzleUserRepository } from "../database/repositories/DrizzleUserRepository.js";
import { DrizzleSessionRepository } from "../database/repositories/DrizzleSessionRepository.js";
import { DrizzlePasswordResetTokenRepository } from "../database/repositories/DrizzlePasswordResetTokenRepository.js";
<% } -%>
<% if (config.mailer === "console") { -%>
import { ConsoleMailer } from "../mail/ConsoleMailer.js";
<% } -%>
import { RegisterUseCase } from "../../application/auth/RegisterUseCase.js";
import { LoginUseCase } from "../../application/auth/LoginUseCase.js";
import { CreateSessionUseCase } from "../../application/auth/CreateSessionUseCase.js";
import { ValidateSessionUseCase } from "../../application/auth/ValidateSessionUseCase.js";
import { LogoutUseCase } from "../../application/auth/LogoutUseCase.js";
import { RequestPasswordResetUseCase } from "../../application/auth/RequestPasswordResetUseCase.js";
import { ResetPasswordUseCase } from "../../application/auth/ResetPasswordUseCase.js";

/**
 * Composition root. Each adapter is chosen by an INDEPENDENT switch
 * (`hasDatabase()`), never a global `isDemo`-style flag: that way the
 * database can be turned on without the mailer being configured, or vice
 * versa, without one flag switching everything off at once.
 */
function buildContainer() {
  const clock = new SystemClock();
  const logger = new ConsoleLogger();
  const passwordHasher = new BcryptPasswordHasher();
<% if (config.mailer === "console") { -%>
  const mailer = new ConsoleMailer();
<% } -%>

<% if (config.db === "postgres-docker") { -%>
  const userRepository = hasDatabase() ? new DrizzleUserRepository() : new InMemoryUserRepository();
  const sessionRepository = hasDatabase()
    ? new DrizzleSessionRepository()
    : new InMemorySessionRepository();
  const resetTokenRepository = hasDatabase()
    ? new DrizzlePasswordResetTokenRepository()
    : new InMemoryPasswordResetTokenRepository();
  if (!hasDatabase()) {
    logger.info("DATABASE_URL is not set: using in-memory repositories (data is lost on restart)");
  }
<% } else { -%>
  const userRepository = new InMemoryUserRepository();
  const sessionRepository = new InMemorySessionRepository();
  const resetTokenRepository = new InMemoryPasswordResetTokenRepository();
<% } -%>

  return {
    clock,
    logger,
    passwordHasher,
    userRepository,
    sessionRepository,
    resetTokenRepository,
    registerUseCase: new RegisterUseCase(userRepository, passwordHasher),
    loginUseCase: new LoginUseCase(userRepository, passwordHasher),
    createSessionUseCase: new CreateSessionUseCase(sessionRepository, clock, env.SESSION_TTL_DAYS),
    validateSessionUseCase: new ValidateSessionUseCase(sessionRepository, clock),
    logoutUseCase: new LogoutUseCase(sessionRepository),
    requestPasswordResetUseCase: new RequestPasswordResetUseCase(
      userRepository,
      resetTokenRepository,
<% if (config.mailer === "console") { -%>
      mailer,
<% } -%>
      clock,
      env.APP_URL,
    ),
    resetPasswordUseCase: new ResetPasswordUseCase(
      userRepository,
      resetTokenRepository,
      sessionRepository,
      passwordHasher,
      clock,
    ),
  };
}

export type Container = ReturnType<typeof buildContainer>;

/**
 * A bundler like Next.js's may compile `packages/core` separately for the
 * Server Actions bundle and for the pages/route handlers bundle — each with
 * its own copy of the module. Without this singleton on `globalThis`, each
 * bundle ends up with ITS OWN in-memory Map and users "disappear" depending
 * on which code looked them up. Same trick Prisma Client uses to survive
 * HMR in Next.js.
 */
const globalForContainer = globalThis as unknown as { __forjaContainer?: Container };
export const container = globalForContainer.__forjaContainer ?? buildContainer();
globalForContainer.__forjaContainer = container;
<% } else { -%>
import { SystemClock } from "../clock/SystemClock.js";
import { ConsoleLogger } from "../logging/ConsoleLogger.js";

// auth = "none": there are no session use cases to compose yet.
// Add your own here with `forja add usecase <context>/<Name>`.
function buildContainer() {
  return {
    clock: new SystemClock(),
    logger: new ConsoleLogger(),
  };
}

export const container = buildContainer();
export type Container = ReturnType<typeof buildContainer>;
<% } -%>
