import { defineConfig, devices } from "@playwright/test";
<% if (bdd) { -%>
import { defineBddConfig } from "playwright-bdd";
<% } -%>

/**
 * End-to-end tests of the web app in a real browser: `npm run test:e2e` from
 * the root. Playwright starts what the app needs (and reuses it when it is
 * already running locally).
<% if (java) { -%>
 *
 * Before the first run: `docker compose up -d` (PostgreSQL<%= oauth2 ? " and Keycloak" : "" %>) and,
 * once, `npx playwright install chromium`.
<% } else { -%>
 *
 * Before the first run, once: `npx playwright install chromium`.
<% } -%>
 */
<% if (bdd) { -%>
/**
 * BDD: the feature files Specgate writes when a change is approved, at the
 * repository's root, run as tests — each step in e2e/steps. A step not written
 * yet fails its scenario when it runs, never the generation: red first.
 */
const bddTestDir = defineBddConfig({
  features: "../../features/**/*.feature",
  steps: "e2e/steps/**/*.ts",
  outputDir: ".features-gen",
  missingSteps: "fail-on-run",
});

<% } -%>
const port = Number(process.env.E2E_PORT ?? 3000);
const baseURL = process.env.E2E_BASE_URL ?? `http://localhost:${port}`;

export default defineConfig({
<% if (!bdd) { -%>
  testDir: "./e2e",
<% } -%>
  timeout: 60_000,
  expect: { timeout: 15_000 },
  fullyParallel: false,
  forbidOnly: Boolean(process.env.CI),
  retries: process.env.CI ? 1 : 0,
  reporter: process.env.CI ? [["list"], ["html", { open: "never" }]] : "list",
  use: { baseURL, trace: "retain-on-failure" },
<% if (bdd) { -%>
  projects: [
    { name: "e2e", testDir: "./e2e", testIgnore: "steps/**", use: { ...devices["Desktop Chrome"] } },
    { name: "bdd", testDir: bddTestDir, use: { ...devices["Desktop Chrome"] } },
  ],
<% } else { -%>
  projects: [{ name: "chromium", use: { ...devices["Desktop Chrome"] } }],
<% } -%>
  webServer: [
<% if (java) { -%>
    {
      // The <%= backendName %> API, from the repository root.
      command: "npm run dev:api",
      cwd: "../..",
      url: "http://127.0.0.1:8080<%= healthPath %>",
      timeout: 240_000,
      reuseExistingServer: !process.env.CI,
      stdout: "ignore",
    },
<% } -%>
    {
      command: `npm run dev -- --port ${port}`,
      url: baseURL,
      timeout: 120_000,
      reuseExistingServer: !process.env.CI,
    },
  ],
});
