import { expect, test } from "@playwright/test";

// The whole way through: the web app, the <%= backendName %> API<%= oauth2 ? " and Keycloak" : "" %>.
const title = `E2E task ${Date.now()}`;

test("<%= oauth2 ? "sign in, " : "" %>add a task and mark it done<%= oauth2 ? ", sign out" : "" %>", async ({ page }) => {
  await page.goto("/");
<% if (oauth2) { -%>
  await page.getByRole("button", { name: "Sign in" }).first().click();

  // Keycloak's login page (infra/keycloak: the demo / demo user).
  await page.locator("#username").fill("demo");
  await page.locator("#password").fill("demo");
  await page.locator("#kc-login").click();
<% } else { -%>
  await page.getByRole("link", { name: "Go to my tasks" }).click();
<% } -%>

  await expect(page.getByRole("heading", { name: "My tasks" })).toBeVisible();
  await page.getByLabel("New task").fill(title);
  await page.getByRole("button", { name: "Add" }).click();

  const row = page.getByRole("listitem").filter({ hasText: title });
  await expect(row).toBeVisible();
  await row.getByRole("button", { name: "Mark as done" }).click();
  await expect(row.getByText("Done", { exact: true })).toBeVisible();
<% if (oauth2) { -%>

  await page.getByRole("button", { name: "Sign out" }).click();
  await expect(page.getByRole("button", { name: "Sign in" }).first()).toBeVisible();
<% } -%>
});
<% if (oauth2) { -%>

test("without a session, the tasks page sends you to sign in", async ({ page }) => {
  await page.goto("/tasks");
  await expect(page.getByRole("button", { name: "Sign in" }).first()).toBeVisible();
});
<% } -%>
