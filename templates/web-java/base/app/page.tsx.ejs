import Link from "next/link";
<% if (config.auth === "oauth2") { -%>
import { auth } from "@/auth";
import { SignInButton } from "@/components/user-menu";
<% } -%>

export default async function HomePage() {
<% if (config.auth === "oauth2") { -%>
  const session = await auth();
<% } -%>
  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-semibold"><%= config.name %></h1>
      <p className="text-sm text-gray-600">
        A Next.js web app on top of a <%= backendName %> API with hexagonal architecture. Generated with forja.
      </p>
<% if (config.auth === "oauth2") { -%>
      {session?.user ? (
        <Link href="/tasks" className="inline-block rounded-md bg-brand-600 px-4 py-2 text-sm text-white">
          Go to my tasks
        </Link>
      ) : (
        <SignInButton />
      )}
<% } else { -%>
      <Link href="/tasks" className="inline-block rounded-md bg-brand-600 px-4 py-2 text-sm text-white">
        Go to my tasks
      </Link>
<% } -%>
    </section>
  );
}
