# Development services for <%= config.name %>. `docker compose up -d`
services:
<% if (config.db === "postgres-docker") { -%>
  db:
    image: postgres:<%= versions.postgres %>
    environment:
      POSTGRES_DB: <%= dbName %>
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    # Another local Postgres on 5432? `DB_PORT=5440 docker compose up -d` and the same DB_PORT for the API.
    ports: ["${DB_PORT:-5432}:5432"]
    volumes: ["db-data:/var/lib/postgresql/data"]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d <%= dbName %>"]
      interval: 5s
      retries: 10
<% } -%>
<% if (config.auth === "oauth2") { -%>
  keycloak:
    image: quay.io/keycloak/keycloak:<%= versions.keycloak %>
    # Development only: embedded database, HTTP, and the infra/keycloak realm imported on startup.
    command: ["start-dev", "--import-realm"]
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
      KC_BOOTSTRAP_ADMIN_PASSWORD: admin
      KC_HOSTNAME: http://localhost:8180
      KC_HEALTH_ENABLED: "true"
    ports: ["8180:8080"]
    volumes: ["./infra/keycloak:/opt/keycloak/data/import:ro"]
    # Ready once the realm is imported (~15 s), so `docker compose up --wait` means it.
    # The image has no curl: bash's /dev/tcp asks the management port.
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          exec 3<>/dev/tcp/127.0.0.1/9000 &&
          printf 'GET /health/ready HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3 &&
          grep -q '"UP"' <&3
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 10s
<% } -%>
<% if (config.db === "postgres-docker") { -%>

volumes:
  db-data:
<% } -%>
